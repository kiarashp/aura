# Copy to .env and fill in. Never commit the real .env.
# Postgres connection string (the database address, user and password).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aura"
# Stripe secret key. Use a TEST key (sk_test_...): this is a demo shop.
STRIPEAPIKEY="sk_test_..."
# Optional: Stripe API version to use.
API_VERSION="2025-06-30.basil"
